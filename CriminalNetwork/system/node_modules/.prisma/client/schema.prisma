// ============================================================
// AI-POWERED CRIMINAL NETWORK ANALYSIS — PRISMA SCHEMA (v4)
// Derived from: src/models/schema.py (v3 — Multi-Case Architecture)
// Source of truth: src/models/schema.py
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

generator prisma {
  provider = "prisma-client-py"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================================
// ENUMS — Pipeline Core
// ============================================================

enum EntityType {
  PERSON
  PHONE
  VEHICLE
  LOCATION
  ACCOUNT
  ORGANIZATION
  EVENT
  DEVICE
  AMOUNT
  DATE
  DOCUMENT
  EMAIL
  VEHICLE_PLATE
  IP_ADDRESS
  CASE_NUMBER
  UNKNOWN
}

enum RelationType {
  CALLED
  MESSED
  ASSOCIATED_WITH
  TRANSFERRED_TO
  RECEIVED_FROM
  OWNS_ACCOUNT
  FAMILY_OF
  FRIEND_OF
  ASSOCIATE_OF
  WORKS_WITH
  LIVES_AT
  WORKS_AT
  VISITED
  SUSPECT_OF
  VICTIM_OF
  WITNESS_OF
  MEMBER_OF
  EXTRACTED_FROM
  DERIVED_FROM
  POSSIBLE_IDENTITY
  SAME_AS
}

enum SemanticEdgeType {
  ENTREPRENEURIAL
  ASSOCIATIONAL
  QUASI_GOVERNMENTAL
}

enum EpistemicCategory {
  OBSERVATION
  INFERENCE
  HYPOTHESIS
  UNKNOWN_PROVENANCE
}

enum ProvenanceClass {
  OBSERVATIONAL
  DERIVED
  INVESTIGATIVE
  MODEL_GENERATED
}

enum VerificationStatus {
  UNVERIFIED
  CORROBORATED
  INDEPENDENTLY_VERIFIED
  LEGALLY_ESTABLISHED
}

enum ContradictionType {
  IDENTITY
  TEMPORAL
  LOCATION
  ATTRIBUTION
  SOURCE_CONTENT
  EVENT_IDENTITY
  DERIVATION
  UNKNOWN
}

enum ContradictionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// ENUMS — Domain Models
// ============================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CaseStatus {
  ACTIVE
  PENDING
  SOLVED
  CLOSED
}

enum UserRole {
  INSPECTOR
  ADMIN
  AUDIT_LOGGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  FORCE_PASSWORD_CHANGE
}

enum SuspectStatus {
  UNDER_INVESTIGATION
  ARRESTED
  CHARGED
  CONVICTED
  ACQUITTED
  RELEASED
}

enum EvidenceStatus {
  LOGGED
  COLLECTED
  ANALYZED
  ADMITTED
  DISMISSED
}

enum CaseEntityRole {
  SUSPECT
  VICTIM
  WITNESS
  ASSOCIATE
  VEHICLE_OWNER
}

enum MergeType {
  AUTO
  REVIEW
  REJECT
  SINGLE
  LLM
}

enum CandidateStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum GraphNodeResolutionStatus {
  RESOLVED
  STANDALONE
  UNRESOLVED
}

enum AdversarialRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FaceStatus {
  PENDING
  EXTRACTED
  MATCHED
  CONFIRMED
  REJECTED
  LOW_QUALITY
}

enum SourceType {
  CDR
  BANK
  FIR
  CCTV
  SOCIAL
  DEVICE
  TEXT
  DOCUMENT
  IMAGE
  AUDIO
  VIDEO
  UNKNOWN
}

enum DocumentType {
  FIR
  CDR
  BANK_RECORD
  CCTV_LOG
  SOCIAL_MEDIA
  DEVICE_FORENSIC
  WITNESS_STATEMENT
  SURVEILLANCE_REPORT
  JOURNALIST_NOTE
  INVESTIGATOR_SUMMARY
  UNKNOWN
}

enum PipelineRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

// ============================================================
// ENUMS — Jurisdiction & Multi-Case
// ============================================================

enum JurisdictionNodeType {
  NATION
  STATE_UT
  COMMISSIONERATE
  RANGE
  DISTRICT
  CITY
  ZONE
  DIVISION
  SUB_DIVISION
  POLICE_STATION
  OUT_POST
}

enum JurisdictionNodeStatus {
  ACTIVE
  INACTIVE
  MERGED
  SPLIT
}

enum CaseJurisdictionLinkType {
  PRIMARY
  ASSIST
  TRANSFER
  LINKED
}

enum UnresolvedJurisdictionStatus {
  UNRESOLVED
  RESOLVED
  REJECTED
}

enum CrossCaseAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// ENUMS — CaseRelationship
// ============================================================

enum CaseRelationshipAssessment {
  SHARED_ENTITY
  POSSIBLE_SAME_INCIDENT
  POSSIBLE_RELATED_CASE
  SAME_INCIDENT
  RELATED_CASE
}

enum CaseRelationshipStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

// ============================================================
// ENUMS — CaseAccess
// ============================================================

enum CaseAccessLevel {
  READ
  WRITE
  ADMIN
}

// ============================================================
// ENUMS — InvestigationWorkspace
// ============================================================

enum WorkspaceRole {
  OWNER
  MEMBER
  VIEWER
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

// ============================================================
// ENUMS — AnalysisRun
// ============================================================

enum AnalysisRunScopeType {
  LOCAL
  SCOPED
}

enum AnalysisRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ============================================================
// ENUMS — Finding
// ============================================================

enum FindingType {
  HYPOTHESIS
  ANOMALY
  PATTERN
  CRITIC_VERDICT
}

enum CriticStatus {
  PENDING
  CORROBORATED
  REFUTED
  INCONCLUSIVE
}

// ============================================================
// ENUMS — FIR Lifecycle
// ============================================================

enum FIRInvestigationStatus {
  REGISTERED
  UNDER_INVESTIGATION
  CHARGE_SHEETED
  FINAL_REPORT
  CLOSED
}

enum FIRLegalDisposition {
  NONE
  CANCELLED
  QUASHED
  DISPOSED
  CONVICTED
  ACQUITTED
}

enum FIRRecordStatus {
  ACTIVE
  ARCHIVED
  SEALED
}

enum FIRLifecycleDimension {
  INVESTIGATION_STATUS
  LEGAL_DISPOSITION
  RECORD_STATUS
}

// ============================================================
// CORE TABLES
// ============================================================

model PipelineRun {
  id                 String            @id @default(uuid())
  caseId             String?
  jurisdictionNodeId String?
  pipelineVersion    String            @default("v1.0")
  modelVersions      Json?
  policyVersion      String            @default("policy_v1.0")
  triggerType        String
  status             PipelineRunStatus @default(RUNNING)
  startTime          DateTime          @default(now())
  endTime            DateTime?
  parentRunId        String?
  inputFiles         Json
  summary            Json?

  // Relations
  case                Case?                       @relation(fields: [caseId], references: [id])
  ingestedFiles       IngestedFile[]
  dataQualityScores   DataQualityScore[]
  adversarialChecks   AdversarialCheck[]
  dependencyGroups    DependencyGroup[]
  extractionLogs      ExtractionLog[]
  resolvedEntities    ResolvedEntity[]
  candidates          EntityResolutionCandidate[]
  contradictions      Contradiction[]
  resolutionHistories ResolutionHistory[]
  temporalInfos       TemporalInfo[]
  spatialInfos        SpatialInfo[]
  coverageIntervals   CoverageInterval[]
  graphNodes          GraphNode[]
  graphEdges          GraphEdge[]
  missingEdges        MissingEdge[]
  rejectedEdges       RejectedEdge[]
  adversarialScores   AdversarialEdgeScore[]
  eventClusters       EventCluster[]
  ExtractedEntity     ExtractedEntity[]
  ExtractedRelation   ExtractedRelation[]
}

model Case {
  id                 String     @id @default(uuid())
  jurisdictionNodeId String
  locationId         String?
  caseStatus         CaseStatus @default(ACTIVE)
  description        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime?

  // Relations
  jurisdictionNode    JurisdictionNode         @relation(fields: [jurisdictionNodeId], references: [id])
  location            Location?                @relation(fields: [locationId], references: [id])
  pipelineRuns        PipelineRun[]
  fir                 FIR? // One-to-one: Case has exactly one primary FIR
  entities            CaseEntityLink[]
  evidence            Evidence[]
  suspects            Suspect[]
  narrativeEmbeddings CaseNarrativeEmbedding[]
  jurisdictionLinks   CaseJurisdictionLink[]
  // Revision 3+ relations
  caseRelationshipsA  CaseRelationship[]       @relation("CaseA")
  caseRelationshipsB  CaseRelationship[]       @relation("CaseB")
  caseAccesses        CaseAccess[]
  workspaceCases      WorkspaceCase[]
  analysisRunCases    AnalysisRunCase[]
  globalEntityLinks   GlobalEntityLink[]
  crossCaseAlertCases CrossCaseAlertCase[]
}

model FIR {
  id                  String                 @id @default(uuid())
  caseId              String                 @unique // One-to-one: one FIR per Case
  firNumber           String
  jurisdictionNodeId  String
  description         String
  filedById           String
  firDocumentR2Key    String?
  filedAt             DateTime?
  // Lifecycle fields (mutable, authorization-controlled)
  investigationStatus FIRInvestigationStatus @default(REGISTERED)
  legalDisposition    FIRLegalDisposition    @default(NONE)
  recordStatus        FIRRecordStatus        @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime?

  // Relations
  case             Case                  @relation(fields: [caseId], references: [id])
  jurisdictionNode JurisdictionNode      @relation(fields: [jurisdictionNodeId], references: [id])
  filedBy          User                  @relation(fields: [filedById], references: [id])
  lifecycleHistory FIRLifecycleHistory[]

  @@unique([firNumber, jurisdictionNodeId])
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String
  passwordHash       String
  role               UserRole
  status             UserStatus @default(FORCE_PASSWORD_CHANGE)
  jurisdictionNodeId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime?

  // Relations
  jurisdictionNode                JurisdictionNode?         @relation(fields: [jurisdictionNodeId], references: [id])
  firsFiled                       FIR[]
  caseEntityLinks                 CaseEntityLink[]
  evidenceLogged                  Evidence[]
  evidenceUploaded                EvidenceFile[]
  suspectsConvicted               Suspect[]
  facesConfirmed                  FaceEmbedding[]
  contradictionsResolved          Contradiction[]           @relation("ContradictionResolver")
  resolutionHistories             ResolutionHistory[]       @relation("ResolutionHistoryChanger")
  auditLogs                       AuditLog[]
  // Revision 3+ relations
  caseAccessesGranted             CaseAccess[]              @relation("CaseAccessGranter")
  caseAccessesOwned               CaseAccess[]              @relation("CaseAccessUser")
  workspaceMemberships            WorkspaceMember[]
  workspacesCreated               InvestigationWorkspace[]
  workspacesCaseAdded             WorkspaceCase[]           @relation("WorkspaceCaseAdder")
  analysisRunsCreated             AnalysisRun[]
  findingsCreated                 Finding[]
  firLifecycleChanges             FIRLifecycleHistory[]
  caseRelationshipChanges         CaseRelationshipHistory[] @relation("CaseRelationshipChanger")
  crossCaseAlertsReviewed         CrossCaseAlert[]
  unresolvedJurisdictionsResolved UnresolvedJurisdiction[]
  CaseRelationship                CaseRelationship[]
}

model Location {
  id                       String  @id @default(uuid())
  name                     String?
  lat                      Float
  lng                      Float
  address                  String?
  jurisdictionNodeId       String?
  geographicJurisdictionId String?

  // Relations
  jurisdictionNode       JurisdictionNode?       @relation(fields: [jurisdictionNodeId], references: [id])
  geographicJurisdiction GeographicJurisdiction? @relation(fields: [geographicJurisdictionId], references: [id])
  cases                  Case[]
}

// ============================================================
// STAGE 1: INGESTION
// ============================================================

model IngestedFile {
  id            String        @id @default(uuid())
  runId         String
  caseId        String?
  fileName      String
  filePath      String
  fileExt       String
  fileHash      String
  fileSizeBytes Int
  detectedType  String
  sourceType    SourceType
  documentType  DocumentType?
  ingestionTime DateTime      @default(now())
  modifiedTime  DateTime?
  recordCount   Int?
  rawSummary    String?

  // Relations
  run                PipelineRun         @relation(fields: [runId], references: [id])
  dataQualityScore   DataQualityScore?
  adversarialChecks  AdversarialCheck[]
  evidenceIntegrity  EvidenceIntegrity?
  extractionLogs     ExtractionLog[]
  extractedEntities  ExtractedEntity[]
  extractedRelations ExtractedRelation[]
}

model DataQualityScore {
  id                    String @id @default(uuid())
  ingestedFileId        String @unique
  qualityScore          Float
  completenessScore     Float
  structuralConsistency Float
  contentRichness       Float
  issues                Json?
  runId                 String

  // Relations
  run          PipelineRun  @relation(fields: [runId], references: [id])
  ingestedFile IngestedFile @relation(fields: [ingestedFileId], references: [id])
}

model AdversarialCheck {
  id                String               @id @default(uuid())
  ingestedFileId    String
  isSuspicious      Boolean              @default(false)
  behavioralAnomaly Boolean              @default(false)
  temporalAnomaly   Boolean              @default(false)
  contentAnomaly    Boolean              @default(false)
  duplicateSuspect  Boolean              @default(false)
  riskLevel         AdversarialRiskLevel @default(LOW)
  score             Float
  reasons           Json?
  runId             String

  // Relations
  run          PipelineRun  @relation(fields: [runId], references: [id])
  ingestedFile IngestedFile @relation(fields: [ingestedFileId], references: [id])
}

model EvidenceIntegrity {
  id              String   @id @default(uuid())
  ingestedFileId  String   @unique
  fileHash        String
  hashVerified    Boolean
  isAdversarial   Boolean  @default(false)
  chainOfCustody  Json?
  transformations Json?
  createdAt       DateTime @default(now())

  // Relations
  ingestedFile IngestedFile @relation(fields: [ingestedFileId], references: [id])
}

model DependencyGroup {
  id             String   @id @default(uuid())
  runId          String
  groupName      String
  fileCount      Int      @default(0)
  totalEntities  Int      @default(0)
  totalRelations Int      @default(0)
  createdAt      DateTime @default(now())

  // Relations
  run PipelineRun @relation(fields: [runId], references: [id])
}

// ============================================================
// STAGE 2: EXTRACTION
// ============================================================

model ExtractedEntity {
  id                String            @id @default(uuid())
  runId             String
  caseId            String?
  ingestedFileId    String
  entityType        EntityType
  mentionText       String
  confidenceScore   Float
  startOffset       Int?
  endOffset         Int?
  epistemicCategory EpistemicCategory @default(INFERENCE)
  sourceReliability Int               @default(3)
  evidenceBasis     Int               @default(1)
  derivationDepth   Int               @default(0)
  createdAt         DateTime          @default(now())

  // Relations
  run             PipelineRun                 @relation(fields: [runId], references: [id])
  ingestedFile    IngestedFile                @relation(fields: [ingestedFileId], references: [id])
  sourceRelations ExtractedRelation[]         @relation("SourceEntity")
  targetRelations ExtractedRelation[]         @relation("TargetEntity")
  candidates      EntityResolutionCandidate[]
}

model ExtractedRelation {
  id                String            @id @default(uuid())
  runId             String
  caseId            String?
  ingestedFileId    String
  sourceEntityId    String
  targetEntityId    String
  relationType      RelationType
  confidenceScore   Float
  epistemicCategory EpistemicCategory @default(INFERENCE)
  sourceReliability Int               @default(3)
  evidenceBasis     Int               @default(1)
  derivationDepth   Int               @default(0)
  createdAt         DateTime          @default(now())

  // Relations
  run          PipelineRun     @relation(fields: [runId], references: [id])
  ingestedFile IngestedFile    @relation(fields: [ingestedFileId], references: [id])
  sourceEntity ExtractedEntity @relation("SourceEntity", fields: [sourceEntityId], references: [id])
  targetEntity ExtractedEntity @relation("TargetEntity", fields: [targetEntityId], references: [id])
}

model ExtractionLog {
  id             String   @id @default(uuid())
  runId          String
  ingestedFileId String
  stage          String
  message        String?
  createdAt      DateTime @default(now())

  // Relations
  run          PipelineRun  @relation(fields: [runId], references: [id])
  ingestedFile IngestedFile @relation(fields: [ingestedFileId], references: [id])
}

// ============================================================
// STAGE 3: RESOLUTION
// ============================================================

model ResolvedEntity {
  id                String            @id @default(uuid())
  runId             String
  caseId            String?
  entityType        EntityType
  canonicalName     String
  mergeConfidence   Float
  mergeType         MergeType
  epistemicCategory EpistemicCategory @default(INFERENCE)
  sourceReliability Int               @default(3)
  evidenceBasis     Int               @default(1)
  derivationDepth   Int               @default(0)
  phoneNumbers      Json?
  plateNumbers      Json?
  bankAccounts      Json?
  locationNames     Json?
  createdAt         DateTime          @default(now())

  // Relations
  run                 PipelineRun                 @relation(fields: [runId], references: [id])
  resolutionHistories ResolutionHistory[]
  candidates          EntityResolutionCandidate[]
}

model EntityResolutionCandidate {
  id                String          @id @default(uuid())
  runId             String
  sourceEntityId    String
  candidateEntityId String
  similarityScore   Float
  matchType         String
  status            CandidateStatus @default(PENDING)
  createdAt         DateTime        @default(now())

  // Relations
  run             PipelineRun     @relation(fields: [runId], references: [id])
  sourceEntity    ExtractedEntity @relation(fields: [sourceEntityId], references: [id])
  candidateEntity ResolvedEntity  @relation(fields: [candidateEntityId], references: [id])
}

model Contradiction {
  id                String                @id @default(uuid())
  runId             String
  contradictionType ContradictionType
  severity          ContradictionSeverity
  description       String
  entities          Json
  isResolved        Boolean               @default(false)
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime              @default(now())

  // Relations
  run                 PipelineRun         @relation(fields: [runId], references: [id])
  resolver            User?               @relation("ContradictionResolver", fields: [resolvedById], references: [id])
  resolutionHistories ResolutionHistory[]
}

model ResolutionHistory {
  id              String   @id @default(uuid())
  runId           String
  entityId        String
  action          String
  oldConfidence   Float?
  newConfidence   Float?
  changedById     String
  reason          String?
  contradictionId String?
  createdAt       DateTime @default(now())

  // Relations
  run           PipelineRun    @relation(fields: [runId], references: [id])
  entity        ResolvedEntity @relation(fields: [entityId], references: [id])
  changedBy     User           @relation("ResolutionHistoryChanger", fields: [changedById], references: [id])
  contradiction Contradiction? @relation(fields: [contradictionId], references: [id])
}

// ============================================================
// STAGE 4: TEMPORAL
// ============================================================

model TemporalInfo {
  id              String    @id @default(uuid())
  runId           String
  entityId        String
  timeExpression  String
  normalizedStart DateTime?
  normalizedEnd   DateTime?
  granularity     String?
  confidence      Float
  createdAt       DateTime  @default(now())

  // Relations
  run PipelineRun @relation(fields: [runId], references: [id])
}

model SpatialInfo {
  id           String   @id @default(uuid())
  runId        String
  entityId     String
  locationName String?
  lat          Float?
  lng          Float?
  radius       Float?
  confidence   Float
  createdAt    DateTime @default(now())

  // Relations
  run PipelineRun @relation(fields: [runId], references: [id])
}

model CoverageInterval {
  id              String   @id @default(uuid())
  runId           String
  entityId        String
  startYear       Int
  endYear         Int?
  coveragePercent Float
  createdAt       DateTime @default(now())

  // Relations
  run PipelineRun @relation(fields: [runId], references: [id])
}

// ============================================================
// STAGE 5: GRAPH
// ============================================================

model GraphNode {
  id               String                    @id @default(uuid())
  runId            String
  caseId           String?
  nodeType         EntityType
  canonicalName    String
  confidence       Float
  resolutionStatus GraphNodeResolutionStatus @default(UNRESOLVED)
  provenanceChain  Json?
  createdAt        DateTime                  @default(now())

  // Relations
  run              PipelineRun    @relation(fields: [runId], references: [id])
  outgoingEdges    GraphEdge[]    @relation("SourceNode")
  incomingEdges    GraphEdge[]    @relation("TargetNode")
  missingOutgoing  MissingEdge[]  @relation("MissingSource")
  missingIncoming  MissingEdge[]  @relation("MissingTarget")
  rejectedOutgoing RejectedEdge[] @relation("RejectedSource")
  rejectedIncoming RejectedEdge[] @relation("RejectedTarget")
}

model GraphEdge {
  id                 String           @id @default(uuid())
  runId              String
  caseId             String?
  sourceId           String
  targetId           String
  relationshipType   RelationType
  semanticEdgeType   SemanticEdgeType
  edgeType           String
  confidenceScore    Float
  adversarialScore   Float?
  supportingEvidence Json?
  createdAt          DateTime         @default(now())

  // Relations
  run               PipelineRun            @relation(fields: [runId], references: [id])
  sourceNode        GraphNode              @relation("SourceNode", fields: [sourceId], references: [id])
  targetNode        GraphNode              @relation("TargetNode", fields: [targetId], references: [id])
  adversarialScores AdversarialEdgeScore[]
}

model MissingEdge {
  id           String   @id @default(uuid())
  runId        String
  sourceId     String
  targetId     String
  expectedType String
  confidence   Float
  createdAt    DateTime @default(now())

  // Relations
  run        PipelineRun @relation(fields: [runId], references: [id])
  sourceNode GraphNode   @relation("MissingSource", fields: [sourceId], references: [id])
  targetNode GraphNode   @relation("MissingTarget", fields: [targetId], references: [id])
}

model RejectedEdge {
  id         String   @id @default(uuid())
  runId      String
  sourceId   String
  targetId   String
  reason     String
  confidence Float
  createdAt  DateTime @default(now())

  // Relations
  run        PipelineRun @relation(fields: [runId], references: [id])
  sourceNode GraphNode   @relation("RejectedSource", fields: [sourceId], references: [id])
  targetNode GraphNode   @relation("RejectedTarget", fields: [targetId], references: [id])
}

model AdversarialEdgeScore {
  id        String               @id @default(uuid())
  runId     String
  edgeId    String
  riskLevel AdversarialRiskLevel
  score     Float
  factors   Json?
  createdAt DateTime             @default(now())

  // Relations
  run  PipelineRun @relation(fields: [runId], references: [id])
  edge GraphEdge   @relation(fields: [edgeId], references: [id])
}

model EventCluster {
  id            String   @id @default(uuid())
  runId         String
  clusterName   String
  eventCount    Int
  avgConfidence Float
  timeRange     Json?
  createdAt     DateTime @default(now())

  // Relations
  run PipelineRun @relation(fields: [runId], references: [id])
}

// ============================================================
// KNOWLEDGE GRAPH ENTITIES
// ============================================================

model Person {
  id               String    @id @default(uuid())
  canonicalName    String
  gender           Gender?
  dob              DateTime?
  nationalIdNumber String?
  photoR2Key       String?
  identitySource   String    @default("MANUAL")
  nameConfidence   Float?
  createdById      String?
  createdAt        DateTime  @default(now())

  // Relations
  aliases        PersonAlias[]
  phones         Phone[]
  vehicles       Vehicle[]
  bankAccounts   BankAccount[]
  caseLinks      CaseEntityLink[]
  suspects       Suspect[]
  faceEmbeddings FaceEmbedding[]
}

model PersonAlias {
  id       String  @id @default(uuid())
  personId String
  alias    String
  source   String?

  // Relations
  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, alias])
}

model Phone {
  id         String    @id @default(uuid())
  number     String
  personId   String?
  carrier    String?
  verifiedAt DateTime?

  // Relations
  person Person? @relation(fields: [personId], references: [id])

  @@unique([number])
}

model Vehicle {
  id          String  @id @default(uuid())
  plateNumber String
  personId    String?
  type        String?
  color       String?

  // Relations
  person Person? @relation(fields: [personId], references: [id])

  @@unique([plateNumber])
}

model BankAccount {
  id                     String  @id @default(uuid())
  accountNumberEncrypted String
  bankName               String
  ifsc                   String?
  personId               String?

  // Relations
  person Person? @relation(fields: [personId], references: [id])
}

model CaseEntityLink {
  id        String         @id @default(uuid())
  caseId    String
  personId  String
  role      CaseEntityRole
  addedById String
  addedAt   DateTime       @default(now())

  // Relations
  case    Case   @relation(fields: [caseId], references: [id])
  person  Person @relation(fields: [personId], references: [id])
  addedBy User   @relation(fields: [addedById], references: [id])

  @@unique([caseId, personId])
}

// ============================================================
// EVIDENCE MANAGEMENT
// ============================================================

model Evidence {
  id          String         @id @default(uuid())
  caseId      String
  suspectId   String?
  type        String
  status      EvidenceStatus @default(LOGGED)
  description String?
  collectedAt DateTime       @default(now())
  loggedById  String

  // Relations
  case     Case           @relation(fields: [caseId], references: [id])
  suspect  Suspect?       @relation(fields: [suspectId], references: [id])
  loggedBy User           @relation(fields: [loggedById], references: [id])
  files    EvidenceFile[]
}

model EvidenceFile {
  id               String   @id @default(uuid())
  evidenceId       String
  fileType         String
  r2Key            String
  mimeType         String?
  originalFileName String?
  sizeBytes        Int?
  uploadedById     String
  uploadedAt       DateTime @default(now())

  // Relations
  evidence        Evidence         @relation(fields: [evidenceId], references: [id])
  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  ocrResult       OcrResult?
  audioTranscript AudioTranscript?
  faceEmbeddings  FaceEmbedding[]
}

model OcrResult {
  id             String   @id @default(uuid())
  evidenceFileId String   @unique
  extractedText  String?
  confidence     Float?
  language       String?
  processedAt    DateTime @default(now())

  // Relations
  evidenceFile EvidenceFile @relation(fields: [evidenceFileId], references: [id])
}

model AudioTranscript {
  id              String   @id @default(uuid())
  evidenceFileId  String   @unique
  transcriptText  String?
  language        String?
  durationSeconds Int?
  confidence      Float?
  processedAt     DateTime @default(now())

  // Relations
  evidenceFile EvidenceFile @relation(fields: [evidenceFileId], references: [id])
}

// ============================================================
// FACE RECOGNITION
// ============================================================

model FaceEmbedding {
  id                 String                     @id @default(uuid())
  personId           String?
  suspectId          String?
  evidenceFileId     String?
  sourceImageR2Key   String
  sourceType         String?
  embeddingVector    Unsupported("vector(512)")
  detectorConfidence Float
  matchConfidence    Float?
  status             FaceStatus                 @default(PENDING)
  confirmedById      String?
  confirmedAt        DateTime?
  createdAt          DateTime                   @default(now())

  // Relations
  person       Person?       @relation(fields: [personId], references: [id])
  suspect      Suspect?      @relation(fields: [suspectId], references: [id])
  evidenceFile EvidenceFile? @relation(fields: [evidenceFileId], references: [id])
  confirmedBy  User?         @relation(fields: [confirmedById], references: [id])

  @@index([personId, status])
  @@index([suspectId])
  @@index([evidenceFileId])
}

// ============================================================
// GEOSPATIAL RISK
// ============================================================

model CrimeZoneScore {
  id                 String   @id @default(uuid())
  h3Index            String
  riskScore          Float
  band               String
  offenseType        String?
  jurisdictionNodeId String
  computedAt         DateTime @default(now())

  // Relations
  jurisdictionNode JurisdictionNode @relation(fields: [jurisdictionNodeId], references: [id])

  @@index([h3Index])
  @@index([jurisdictionNodeId, computedAt])
}

// ============================================================
// SEMANTIC SEARCH
// ============================================================

model CaseNarrativeEmbedding {
  id              String                      @id @default(uuid())
  caseId          String
  sourceText      String
  embeddingVector Unsupported("vector(1536)")
  createdAt       DateTime                    @default(now())

  // Relations
  case Case @relation(fields: [caseId], references: [id])

  @@index([caseId])
}

// ============================================================
// SUSPECT LIFECYCLE
// ============================================================

model Suspect {
  id                   String        @id @default(uuid())
  caseId               String
  personId             String?
  name                 String
  gender               Gender?
  dob                  DateTime?
  nationalIdNumber     String?
  status               SuspectStatus @default(UNDER_INVESTIGATION)
  arrestDate           DateTime?
  contactInfo          String?
  photoR2Key           String?
  criminalRecordNumber String?       @unique
  convictedById        String?
  convictedAt          DateTime?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime?

  // Relations
  case           Case            @relation(fields: [caseId], references: [id])
  person         Person?         @relation(fields: [personId], references: [id])
  convictedBy    User?           @relation(fields: [convictedById], references: [id])
  evidence       Evidence[]
  faceEmbeddings FaceEmbedding[]

  @@index([personId, caseId])
  @@index([status])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action])
  @@index([resourceType, resourceId])
}

// ============================================================
// JURISDICTION HIERARCHY (v3 — Multi-Case Architecture)
// ============================================================

model JurisdictionNode {
  id        String                 @id @default(uuid())
  name      String
  nodeType  JurisdictionNodeType
  parentId  String?
  status    JurisdictionNodeStatus @default(ACTIVE)
  code      String?
  validFrom DateTime               @default(now())
  validTo   DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime?

  // Relations
  parent                  JurisdictionNode?        @relation("JurisdictionTree", fields: [parentId], references: [id])
  children                JurisdictionNode[]       @relation("JurisdictionTree")
  history                 JurisdictionHistory[]
  caseJurisdictionLinks   CaseJurisdictionLink[]
  globalEntityLinks       GlobalEntityLink[]
  unresolvedJurisdictions UnresolvedJurisdiction[]
  Case                    Case[]
  FIR                     FIR[]
  User                    User[]
  Location                Location[]
  CrimeZoneScore          CrimeZoneScore[]
  InvestigationWorkspace  InvestigationWorkspace[]

  @@index([nodeType])
  @@index([parentId])
  @@index([status])
}

model GeographicJurisdiction {
  id               String    @id @default(uuid())
  name             String
  jurisdictionType String // "state", "district", "city", "zone", "area"
  parentId         String?
  boundaryPolygon  Json? // GeoJSON polygon
  centerLat        Float?
  centerLng        Float?
  validFrom        DateTime  @default(now())
  validTo          DateTime?
  createdAt        DateTime  @default(now())

  // Relations
  locations Location[]

  @@index([jurisdictionType])
}

model UnresolvedJurisdiction {
  id                          String                       @id @default(uuid())
  rawText                     String
  sourceFile                  String
  sourceType                  String
  confidence                  Float                        @default(0)
  suggestedJurisdictionNodeId String?
  resolvedById                String?
  resolvedJurisdictionNodeId  String?
  status                      UnresolvedJurisdictionStatus @default(UNRESOLVED)
  createdAt                   DateTime                     @default(now())
  resolvedAt                  DateTime?

  // Relations
  jurisdictionNode JurisdictionNode? @relation(fields: [suggestedJurisdictionNodeId], references: [id])
  User             User?             @relation(fields: [userId], references: [id])
  userId           String?

  @@index([status])
  @@index([sourceType])
}

model JurisdictionHistory {
  id                 String   @id @default(uuid())
  jurisdictionNodeId String
  eventType          String // "created", "renamed", "merged", "split", "reorganized"
  eventDate          DateTime @default(now())
  previousState      Json?
  newState           Json?
  description        String?
  recordedById       String?
  createdAt          DateTime @default(now())

  // Relations
  jurisdictionNode JurisdictionNode @relation(fields: [jurisdictionNodeId], references: [id])

  @@index([jurisdictionNodeId])
  @@index([eventType])
}

model CaseJurisdictionLink {
  id                 String                   @id @default(uuid())
  caseId             String
  jurisdictionNodeId String
  linkType           CaseJurisdictionLinkType
  description        String?
  linkedAt           DateTime                 @default(now())
  linkedById         String?
  validFrom          DateTime                 @default(now())
  validTo            DateTime?

  // Relations
  case             Case             @relation(fields: [caseId], references: [id])
  jurisdictionNode JurisdictionNode @relation(fields: [jurisdictionNodeId], references: [id])

  @@unique([caseId, jurisdictionNodeId, linkType])
  @@index([caseId])
  @@index([jurisdictionNodeId])
  @@index([linkType])
}

// ============================================================
// GLOBAL ENTITY IDENTITY INDEX (v3 — Multi-Case Architecture)
// ============================================================

model GlobalEntity {
  canonicalId        String   @id @default(uuid())
  entityType         String
  canonicalName      String
  phones             Json? // ["9876543210", ...]
  accounts           Json? // ["ACC001", ...]
  addresses          Json? // ["Delhi", ...]
  firstSeen          DateTime @default(now())
  lastSeen           DateTime @default(now())
  totalCases         Int      @default(0)
  totalJurisdictions Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  // Relations
  links           GlobalEntityLink[]
  crossCaseAlerts CrossCaseAlert[]

  @@index([entityType])
  @@index([canonicalName])
}

model GlobalEntityLink {
  id                 String   @id @default(uuid())
  globalEntityId     String
  caseId             String
  localEntityId      String // FK → ResolvedEntity (local to that Case)
  jurisdictionNodeId String // FK → JurisdictionNode (from the Case)
  confidence         Float    @default(0)
  matchType          String // "phone_exact", "name_fuzzy", "account_exact"
  createdAt          DateTime @default(now())

  // Relations
  globalEntity     GlobalEntity     @relation(fields: [globalEntityId], references: [canonicalId])
  jurisdictionNode JurisdictionNode @relation(fields: [jurisdictionNodeId], references: [id])
  Case             Case             @relation(fields: [caseId], references: [id])

  @@unique([globalEntityId, caseId, localEntityId])
  @@index([globalEntityId])
  @@index([caseId])
  @@index([jurisdictionNodeId])
}

model CrossCaseAlert {
  id             String                 @id @default(uuid())
  globalEntityId String
  severity       CrossCaseAlertSeverity @default(MEDIUM)
  recommendation String?
  createdAt      DateTime               @default(now())
  status         String                 @default("ACTIVE") // ACTIVE, REVIEWED, DISMISSED
  reviewedById   String?
  reviewedAt     DateTime?

  // Relations
  globalEntity GlobalEntity         @relation(fields: [globalEntityId], references: [canonicalId])
  cases        CrossCaseAlertCase[]
  User         User?                @relation(fields: [userId], references: [id])
  userId       String?

  @@index([globalEntityId])
  @@index([severity])
  @@index([status])
}

model CrossCaseAlertCase {
  id                 String  @id @default(uuid())
  alertId            String
  caseId             String
  jurisdictionNodeId String?

  // Relations
  alert CrossCaseAlert @relation(fields: [alertId], references: [id])
  Case  Case           @relation(fields: [caseId], references: [id])

  @@unique([alertId, caseId])
  @@index([alertId])
  @@index([caseId])
}

// ============================================================
// CASE RELATIONSHIP (Revision 3+)
// ============================================================

model CaseRelationship {
  id                 String                     @id @default(uuid())
  caseAId            String
  caseBId            String
  initialObservation CaseRelationshipAssessment
  currentAssessment  CaseRelationshipAssessment
  confidence         Float                      @default(0)
  evidenceSummary    String?
  detectedBy         String                     @default("SYSTEM") // SYSTEM | INVESTIGATOR
  status             CaseRelationshipStatus     @default(SUGGESTED)
  confirmedById      String?
  confirmedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime?

  // Relations
  caseA       Case                      @relation("CaseA", fields: [caseAId], references: [id])
  caseB       Case                      @relation("CaseB", fields: [caseBId], references: [id])
  confirmedBy User?                     @relation(fields: [confirmedById], references: [id])
  history     CaseRelationshipHistory[]

  @@unique([caseAId, caseBId])
  @@index([caseAId])
  @@index([caseBId])
  @@index([currentAssessment])
  @@index([status])
}

model CaseRelationshipHistory {
  id                 String                      @id @default(uuid())
  caseRelationshipId String
  previousAssessment CaseRelationshipAssessment?
  newAssessment      CaseRelationshipAssessment
  previousStatus     CaseRelationshipStatus?
  newStatus          CaseRelationshipStatus
  previousConfidence Float?
  newConfidence      Float
  changedById        String?
  changeReason       String?
  createdAt          DateTime                    @default(now())

  // Relations
  caseRelationship CaseRelationship @relation(fields: [caseRelationshipId], references: [id])
  changedBy        User?            @relation("CaseRelationshipChanger", fields: [changedById], references: [id])

  @@index([caseRelationshipId])
  @@index([createdAt])
}

// ============================================================
// CASE ACCESS / AUTHORIZATION (Revision 3+)
// ============================================================

model CaseAccess {
  id          String          @id @default(uuid())
  userId      String
  caseId      String
  accessLevel CaseAccessLevel @default(READ)
  grantedById String
  grantedAt   DateTime        @default(now())
  expiresAt   DateTime?

  // Relations
  user      User @relation("CaseAccessUser", fields: [userId], references: [id])
  case      Case @relation(fields: [caseId], references: [id])
  grantedBy User @relation("CaseAccessGranter", fields: [grantedById], references: [id])

  @@unique([userId, caseId])
  @@index([userId])
  @@index([caseId])
  @@index([accessLevel])
}

// ============================================================
// INVESTIGATION WORKSPACE (Revision 3+)
// ============================================================

model InvestigationWorkspace {
  id                 String          @id @default(uuid())
  name               String
  description        String?
  createdById        String
  jurisdictionNodeId String?
  status             WorkspaceStatus @default(ACTIVE)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime?

  // Relations
  createdBy        User              @relation(fields: [createdById], references: [id])
  jurisdictionNode JurisdictionNode? @relation(fields: [jurisdictionNodeId], references: [id])
  cases            WorkspaceCase[]
  members          WorkspaceMember[]
  AnalysisRun      AnalysisRun[]
}

model WorkspaceCase {
  id          String   @id @default(uuid())
  workspaceId String
  caseId      String
  addedById   String
  addedAt     DateTime @default(now())

  // Relations
  workspace InvestigationWorkspace @relation(fields: [workspaceId], references: [id])
  case      Case                   @relation(fields: [caseId], references: [id])
  addedBy   User                   @relation("WorkspaceCaseAdder", fields: [addedById], references: [id])

  @@unique([workspaceId, caseId])
  @@index([workspaceId])
  @@index([caseId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  // Relations
  workspace InvestigationWorkspace @relation(fields: [workspaceId], references: [id])
  user      User                   @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ============================================================
// ANALYSIS RUN (Revision 3+)
// ============================================================

model AnalysisRun {
  id              String               @id @default(uuid())
  workspaceId     String?
  createdById     String
  scopeType       AnalysisRunScopeType @default(LOCAL)
  description     String?
  pipelineVersion String?
  modelVersions   Json?
  status          AnalysisRunStatus    @default(RUNNING)
  startedAt       DateTime             @default(now())
  completedAt     DateTime?
  createdAt       DateTime             @default(now())

  // Relations
  workspace InvestigationWorkspace? @relation(fields: [workspaceId], references: [id])
  createdBy User                    @relation(fields: [createdById], references: [id])
  cases     AnalysisRunCase[]
  result    AnalysisRunResult?
  findings  Finding[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
}

model AnalysisRunCase {
  id            String @id @default(uuid())
  analysisRunId String
  caseId        String

  // Relations
  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id])
  case        Case        @relation(fields: [caseId], references: [id])

  @@unique([analysisRunId, caseId])
  @@index([analysisRunId])
  @@index([caseId])
}

model AnalysisRunResult {
  id                        String   @id @default(uuid())
  analysisRunId             String   @unique
  // Input snapshots — written once at completion, never updated
  caseRelationshipsSnapshot Json?
  globalEntityLinksSnapshot Json?
  // Derived outputs — NOT authoritative source
  mergedGraphNodes          Json?
  mergedGraphEdges          Json?
  analytics                 Json?
  mlOutputs                 Json?
  createdAt                 DateTime @default(now())

  // Relations
  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id])
}

// ============================================================
// FINDING (Revision 3+)
// ============================================================

model Finding {
  id                         String       @id @default(uuid())
  analysisRunId              String
  findingType                FindingType
  title                      String
  description                String?
  confidence                 Float        @default(0)
  // Stable references
  supportingCaseIds          Json?
  supportingEntityIds        Json?
  supportingEdgeDescriptions Json?
  supportingEvidenceIds      Json?
  // Critic evaluation
  criticStatus               CriticStatus @default(PENDING)
  criticNotes                String?
  criticConfidence           Float?
  // Provenance
  createdById                String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime?

  // Relations
  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id])
  createdBy   User?       @relation(fields: [createdById], references: [id])

  @@index([analysisRunId])
  @@index([findingType])
  @@index([criticStatus])
}

// ============================================================
// FIR LIFECYCLE HISTORY (Revision 3+)
// ============================================================

model FIRLifecycleHistory {
  id                 String                @id @default(uuid())
  firId              String
  dimension          FIRLifecycleDimension
  previousValue      String?
  newValue           String
  changedById        String
  changedAt          DateTime              @default(now())
  reason             String?
  authorityReference String?
  createdAt          DateTime              @default(now())

  // Relations
  fir       FIR  @relation(fields: [firId], references: [id])
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([firId])
  @@index([dimension])
  @@index([changedAt])
}
